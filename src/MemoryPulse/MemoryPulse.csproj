<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MemoryPulse</AssemblyName>
    <RootNamespace>MemoryPulse</RootNamespace>
    <Version>1.4.0</Version>
    <Product>MemoryPulse</Product>
    <Description>See what is really using your RAM, and learn why cached memory is not wasted.</Description>
    <Copyright>Copyright (c) 2026 Ahmet Ünal Uzun</Copyright>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="Lang\*.json" LogicalName="MemoryPulse.Lang.%(Filename).json" />
  </ItemGroup>
</Project>
